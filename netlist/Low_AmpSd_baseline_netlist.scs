        sca=114.17432 scb=0.08203 scc=0.01268 m=(1)
    M5 (out b4 net39 vss) g45n2svt w=(320n) l=150n nf=1 as=48f ad=48f \
        ps=940n pd=940n nrd=468.75m nrs=468.75m sa=150n sb=150n sd=200n \
        sca=114.17432 scb=0.08203 scc=0.01268 m=(1)
    M4 (vss b4 b4 vss) g45n2svt w=(320n) l=150n nf=1 as=48f ad=48f ps=940n \
