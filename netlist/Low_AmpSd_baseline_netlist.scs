        sca=24.37763 scb=0.02712 scc=0.00086 m=(1)
    M11 (b3 b3 vdd vdd) g45p2svt w=(320n) l=150n nf=1 as=48f ad=48f \
        ps=940n pd=940n nrd=468.75m nrs=468.75m sa=150n sb=150n sd=200n \
        sca=24.37763 scb=0.02712 scc=0.00086 m=(1)
    M7 (net14 b2 vdd vdd) g45p2svt w=(320n) l=150n nf=1 as=48f ad=48f \
